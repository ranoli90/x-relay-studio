# Copy to .env.local. Never commit real secrets.

# Required in production. Neon pooled connection string.
DATABASE_URL=

# Required in production. 32+ random bytes. Used for sessions AND token envelopes.
BETTER_AUTH_SECRET=

# Public origin of this deployment. No trailing slash.
BETTER_AUTH_URL=https://example.vercel.app

# Extra origins allowed for Reddit OAuth redirects (comma-separated).
ALLOWED_ORIGINS=

# Optional dedicated envelope key. Falls back to BETTER_AUTH_SECRET.
SECRETS_ENCRYPTION_KEY=
REDDIT_VAULT_KEY_ID=default

# Reddit onboarding. Assisted signup stays off until approval and Browserbase are real.
REDDIT_ENABLED=true
REDDIT_ONBOARDING_ENABLED=false
REDDIT_ASSISTED_SIGNUP_ENABLED=false
REDDIT_REMOTE_OAUTH_ENABLED=false
REDDIT_BROWSER_PROVIDER=fake
REDDIT_WORKFLOW_VERSION=email-signup.v1
REDDIT_SESSION_MAX_SECONDS=900
REDDIT_ONBOARDING_GLOBAL_CONCURRENCY=3
REDDIT_BROWSER_CONTEXT_RETENTION_DAYS=30

# Separate features. All default off. Existing-email / copy-to-Reddit still work.
REDDIT_DRAFTING_ENABLED=false
REDDIT_PUBLISH_ENABLED=false
REDDIT_EMAIL_BINDING_ENABLED=false
REDDIT_ONBOARDING_FIXTURE=false

# Isolated Postgres for RC-001 race tests. Ordinary CI must leave this unset.
# REDDIT_TEST_DATABASE_URL=

# Browserbase — server/worker only. Never prefix with VITE_.
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=

# Selected Stagehand model id. Supply that provider’s documented secret separately.
STAGEHAND_MODEL=

# OpenRouter. Fail-closed if missing — rewrites will not run.
OPENROUTER_API_KEY=

# Payment rails. Screenshot is never PAID. Authorization: Bearer
PAYMENTS_WEBHOOK_SECRET=


# Optional Telegram platform OIDC / helper bot. Per-desk user apps are preferred.
# If a desk posts its own API ID + hash from my.telegram.org, those win.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_MTPROTO_ENABLED=true
# Leave unset to try TCP then WSS. Set true/false to pin one transport.
# TELEGRAM_MTPROTO_WSS=

# Pin before the first login on a session. Do not change later or Telegram
# treats the desk as a new unofficial client on the same auth key.
TELEGRAM_DEVICE_MODEL=X Relay Studio
TELEGRAM_SYSTEM_VERSION=X Relay Studio
TELEGRAM_APP_VERSION=0.1.0

# Kill switches. Unofficial X lookup is OFF on Vercel unless set true.
FXTWITTER_ENABLED=false
REDDIT_ENABLED=true
CRON_ENABLED=true
OPENROUTER_ENABLED=true

# Preview-only. Never set false in production — it used to bypass photo auth.
# VITE_AUTH_ENABLED=true
