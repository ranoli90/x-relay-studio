# Copy to .env.local. Never commit real secrets.

# Required in production. Neon pooled connection string.
DATABASE_URL=

# Required in production. 32+ random bytes. Used for sessions AND token envelopes.
BETTER_AUTH_SECRET=

# Public origin of this deployment. No trailing slash.
BETTER_AUTH_URL=https://example.vercel.app

# Extra origins allowed for Reddit OAuth redirects (comma-separated).
ALLOWED_ORIGINS=

# Optional dedicated envelope key. Falls back to BETTER_AUTH_SECRET.
SECRETS_ENCRYPTION_KEY=

# OpenRouter. Fail-closed if missing — rewrites will not run.
OPENROUTER_API_KEY=

# Payment rails. Screenshot is never PAID. Authorization: Bearer
PAYMENTS_WEBHOOK_SECRET=


# Optional Telegram platform OIDC / helper bot. Per-desk user apps are preferred.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_MTPROTO_ENABLED=true

# Kill switches. Unofficial X lookup is OFF on Vercel unless set true.
FXTWITTER_ENABLED=false
REDDIT_ENABLED=true
CRON_ENABLED=true
OPENROUTER_ENABLED=true

# Preview-only. Never set false in production — it used to bypass photo auth.
# VITE_AUTH_ENABLED=true
